{
  // The PS-X EXE entry point is decoded from the executable header by the
  // shipping emitter. These measured main-function re-entry roots let the
  // host-owned frame driver resume after forbidden guest VSync calls.
  "main": [
    // Dynamically reached through the retail interrupt element registered at 0x8008C7CC. The first
    // live state-zero resource continuation invoked this pad/serial IRQ gate from 0x8003C94C.
    "0x8007C9E0",
    // Resource-loader completion callbacks. The loader stores these as function POINTERS in its
    // queue entry (FUN_80032D30 arg 5) and the pump calls them indirectly, so no jal names them.
    // Each is a clean entry: the word two before it is `jr ra`. Measured as the first recomp-MISS
    // once BIGFILE overlay BF0233 resolved (0x80031B00 from caller 0x80031DE4).
    "0x800319E8",
    "0x80031A64",
    "0x80031A78",
    "0x80031AA4",
    "0x80031B00"
  ],
  "main_reentry": [
    // Save the retail setjmp-style IRQ continuation itself, not merely its containing initialization
    // function. The callback pointer at 0x8008AFD0 dispatches here after the pad/serial gate claims
    // the interrupt; a normal function seed cannot make an interior return PC dispatchable.
    "0x80077348",
    // State-zero waits for its XA startup task in a host-starving loop. The native frame owner runs
    // one preserved service call per field and resumes at this exact post-call poll instruction.
    "0x8003C94C",
    "0x80037880",
    "0x80032074",
    "0x8003C7E0",
    "0x8003C7F4",
    "0x8003C8D4",
    "0x8003C8FC",
    "0x8003C984",
    // State-zero race/menu setup calls the same 0x80031FDC fifth-argument -1 branch and must resume
    // at its own post-call instruction after the title-owned two-field wait. That suffix restores
    // 0x80033610's frame and returns to the sole direct caller at 0x8003CC98.
    "0x800336F8",
    "0x8003CC98",
    "0x8003CEB4",
    "0x8003CF38",
    // Hand-written GTE macro library interior entries, reached ONLY through the runtime-built GTE
    // parameter blocks (244-byte strides, e.g. 0x800FEAA8+ in the miss RAM dump): init code builds
    // each block with lui/ori pairs (0x80071484/0x8007148C constructs 0x8006A8E0; its alternate
    // flag branch constructs 0x8007B23C) and `sw t0, 0xF0(fp)` stores it, and the library dispatches
    // with `lw s6, 0xF0(a2)` then `jalr ra, s6` (0x8006A52C). No scan can link the store site to
    // the dispatch site across fragments, so the emitter's constructor-pointer scan correctly
    // declines them; the live [recomp-MISS] named them. Both are clean interior entries: the
    // preceding word is not a branch/jump, and each opens a parallel variant body. Measured live:
    // the nine distinct in-text values in the blocks were 0x8006A52C 0x8006A8E0 0x8006AD88
    // 0x8006B030 0x8006BF30 0x8006C948 0x8006D428 0x8006D55C 0x8006D59C; all but these two were
    // already emitted.
    "0x8006A8E0",
    "0x8006BF30"
  ],
  // BIGFILE.BIG module images and the load bases measured with PSXPORT_DEBUG=cd over a real boot.
  // The BIGFILE index is a table of (sector offset, byte size) pairs from word 2 of the archive; the
  // stem number is that entry's index, so a stem names an archive entry, never a run. The retail
  // executable calls into this slot at absolute addresses (0x800B0B38 from 0x800368BC and the
  // 0x800B4364 family from 0x80033610), so the destinations are deterministic game facts.
  "overlay_bases": {
    "BF0225": "0x8009F6FC",
    "BF0226": "0x800A0CB8",
    "BF0233": "0x800AB9F0"
  },
  "overlay_base_patterns": [],
  "overlay_seeds": {}
}
